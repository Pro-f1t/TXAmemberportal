rules_version = '2';
// Nothing talks to Storage from the browser. Uploads go through the portal's
// API (Admin SDK) and every object carries a download token, which token URLs
// use to bypass rules. Publish these under Storage → Rules in the console.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
