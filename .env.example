# ---- Local development (emulators) ----
# Copy to .env for local work. The dev server reads this at start; restart after edits.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9098
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9198
NEXT_PUBLIC_FIREBASE_EMULATOR=1

# ---- Production (set in Vercel, NOT in a committed file) ----
# Leave all emulator variables unset in Vercel.
# Base64 of the whole service-account JSON:
#   base64 -i <key>.json | tr -d '\n' | pbcopy
# FIREBASE_SERVICE_ACCOUNT_B64=
# FIREBASE_PROJECT_ID=txarecruiting
# Comma-separated Google accounts that become active execs on first sign-in:
# PORTAL_ADMIN_EMAILS=you@utexas.edu
# NEXT_PUBLIC_SITE_URL=https://txa-portal.org
# Rotating QR check-in. Both Sensitive. Changing CHECKIN_SECRET kills any code on screen.
#   openssl rand -hex 32   → CHECKIN_SECRET
#   openssl rand -hex 12   → DISPLAY_KEY (the projector link's ?k=, for a laptop that isn't signed in)
# CHECKIN_SECRET=
# DISPLAY_KEY=
